# Copy this file to .streamlit/secrets.toml (which is gitignored) for local runs.
# On Streamlit Community Cloud, paste the same lines into the app's
# Settings -> Secrets box instead. Never commit the real key.
GEMINI_API_KEY = "paste-your-key-here"
# Optional: force one model instead of the built-in fallback list
# GEMINI_MODEL = "gemini-3.5-flash"
